    "Continues the book you were listening to, or pauses it." : {
      "comment" : "Description of the Smart Stack widget's resume/pause action (App Intent).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setzt das Buch fort, das du gehört hast, oder pausiert es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Continúa el libro que estabas escuchando o lo pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reprend le livre que vous écoutiez, ou le met en pause."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ממשיך את הספר שהאזנת לו, או משהה אותו."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Riprende il libro che stavi ascoltando o lo mette in pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "聴いていた本を再開、または一時停止します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gaat verder met het boek waar je naar luisterde, of pauzeert het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wznawia książkę, której słuchałeś, lub ją wstrzymuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Continua o livro que você estava ouvindo ou o pausa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Продолжает книгу, которую вы слушали, или ставит её на паузу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "继续播放你正在听的书，或将其暂停。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jatkaa kuuntelemaasi kirjaa tai keskeyttää sen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συνεχίζει το βιβλίο που ακούγατε ή το θέτει σε παύση."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "繼續播放你正在聽的書，或將其暫停。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Continues the book you were listening to, or pauses it."
          }
        }
      }
    },
