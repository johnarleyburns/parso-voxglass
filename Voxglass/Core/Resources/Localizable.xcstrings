    "LibriVox accepts only recordings made by human volunteers using their own voices. This project contains imported AI-generated audio and is not eligible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "LibriVox akzeptiert nur Aufnahmen, die Freiwillige mit ihrer eigenen Stimme gemacht haben. Dieses Projekt enthält importiertes KI-generiertes Audio und ist nicht zulässig."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "LibriVox n’accepte que les enregistrements réalisés par des bénévoles avec leur propre voix. Ce projet contient de l’audio généré par IA importé et n’est pas éligible."
          }
        },
