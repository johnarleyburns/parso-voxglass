    "Narrative histories, chronicles, and biographies covering antiquity, the Middle Ages, and the modern era." : {
      "comment" : "UI text shown in: IACollection (Voxglass/Core/Catalog/IACollection.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
