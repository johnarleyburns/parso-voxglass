    "High-seas voyages, frontier tales, and daring quests from Dumas, Henty, Stevenson, and Twain." : {
      "comment" : "UI text shown in: IACollection (Voxglass/Core/Catalog/IACollection.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seefahrten, Grenzland-Geschichten und kühne Abenteuer von Dumas, Henty, Stevenson und Twain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Travesías en alta mar, relatos de frontera y aventuras audaces de Dumas, Henty, Stevenson y Twain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voyages en haute mer, récits de frontière et quêtes audacieuses de Dumas, Henty, Stevenson et Twain."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מסעות בים הפתוח, סיפורי ספר והרפתקאות נועזות מאת דיומא, הנטי, סטיבנסון וטוויין."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Viaggi in alto mare, storie di frontiera e imprese audaci di Dumas, Henty, Stevenson e Twain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "デュマ、ヘンティ、スティーヴンソン、トウェインによる海洋冒険、辺境の物語、大胆な探求。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeereizen, grensverhalen en gewaagde tochten van Dumas, Henty, Stevenson en Twain."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Morskie podróże, opowieści z pogranicza i śmiałe wyprawy Dumasa, Henty’ego, Stevensona i Twaina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Viagens em alto-mar, histórias de fronteira e aventuras ousadas de Dumas, Henty, Stevenson e Twain."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Морские плавания, истории фронтира и дерзкие поиски от Дюма, Хенти, Стивенсона и Твена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
