    "Brief literary gems by Poe, Chekhov, Maupassant, O. Henry, Saki, and dozens of LibriVox short-story collections." : {
      "comment" : "UI text shown in: IACollection (Voxglass/Core/Catalog/IACollection.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
