        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ricerca, navigazione e consigli sono limitati alle lingue scelte. Lasciale tutte disattivate per includere ogni lingua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "検索、ブラウズ、おすすめは選択した言語に限定されます。すべての言語を含めるには、どれも選択しないでください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zoeken, bladeren en aanraders zijn beperkt tot de talen die je kiest. Laat alles uit om elke taal mee te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wyszukiwanie, przeglądanie i rekomendacje są ograniczone do wybranych języków. Nie zaznaczaj żadnego, aby uwzględnić wszystkie."
          }
