          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הזרמה וטעינה מראש של הפרק הבא תמיד משתמשות ברשת הסלולרית. ההגדרה הזו שולטת רק בשמירת ספרים שלמים לשימוש לא מקוון."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
