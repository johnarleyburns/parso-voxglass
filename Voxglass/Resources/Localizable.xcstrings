    "Long pauses between sentences play back faster, then drop to your chosen speed the moment the narrator resumes." : {
      "comment" : "UI text shown in: Settings (Voxglass/Features/Settings/SettingsView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lange Pausen zwischen Sätzen werden schneller abgespielt und fallen auf Ihre gewählte Geschwindigkeit zurück, sobald der Sprecher weiterspricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long pauses between sentences play back faster, then drop to your chosen speed the moment the narrator resumes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las pausas largas entre frases se reproducen más rápido y vuelven a tu velocidad en cuanto el narrador sigue hablando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les longues pauses entre les phrases sont lues plus vite, puis la vitesse revient à celle choisie dès que le narrateur reprend."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הפסקות ארוכות בין משפטים מושמעות מהר יותר, וחוזרות למהירות שבחרת ברגע שהקריין ממשיך."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le lunghe pause tra le frasi vengono riprodotte più velocemente, poi si torna alla velocità scelta appena il narratore riprende."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "文と文の間の長い無音は速く再生され、ナレーターが話し始めると選択した速度に戻ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lange pauzes tussen zinnen worden sneller afgespeeld en gaan terug naar je gekozen snelheid zodra de voorlezer verdergaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Długie przerwy między zdaniami są odtwarzane szybciej, a gdy lektor znów mówi, prędkość wraca do wybranej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pausas longas entre frases tocam mais rápido e voltam à velocidade escolhida assim que o narrador continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Длинные паузы между предложениями проигрываются быстрее, а когда чтец продолжает, скорость возвращается к выбранной."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "句子之间的长停顿会加速播放，朗读者一开口就立即恢复到你选择的速度。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitkät tauot lauseiden välillä toistetaan nopeammin ja palautetaan valitsemaasi nopeuteen heti, kun lukija jatkaa."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι μεγάλες παύσεις μεταξύ προτάσεων παίζουν γρηγορότερα και επιστρέφουν στην ταχύτητα που επιλέξατε μόλις ο αφηγητής συνεχίσει."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "句子之間的長停頓會加速播放，朗讀者一開口就立即恢復到你選擇的速度。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Long pauses between sentences play back faster, then drop to your chosen speed the moment the narrator resumes."
          }
        }
      }
    },
