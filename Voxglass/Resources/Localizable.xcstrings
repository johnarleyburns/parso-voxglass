    "Apple Watch gets My Books directly from this iPhone. Use “Download to Apple Watch” on a book page or in its My Books context menu." : {
      "comment" : "UI text shown in: Settings (Voxglass/Features/Settings/SettingsView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Apple Watch erhält „Meine Bücher“ direkt von diesem iPhone. Verwenden Sie „Auf Apple Watch laden“ auf einer Buchseite oder im Kontextmenü von „Meine Bücher“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch gets My Books directly from this iPhone. Use “Download to Apple Watch” on a book page or in its My Books context menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El Apple Watch recibe Mis libros directamente desde este iPhone. Usa «Descargar en el Apple Watch» en la página de un libro o en su menú contextual de Mis libros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’Apple Watch reçoit Mes livres directement depuis cet iPhone. Utilisez « Télécharger sur l’Apple Watch » sur la page d’un livre ou dans son menu contextuel Mes livres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Watch מקבל את הספרים שלי ישירות מה-iPhone הזה. אפשר להשתמש ב„הורדה ל-Apple Watch” בדף הספר או בתפריט ההקשר שלו בספרים שלי."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Watch riceve I miei libri direttamente da questo iPhone. Usa «Scarica su Apple Watch» nella pagina di un libro o nel suo menu contestuale in I miei libri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Watch はこの iPhone から直接マイブックを受け取ります。本のページまたはマイブックのコンテキストメニューで「Apple Watch にダウンロード」を使ってください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De Apple Watch krijgt Mijn boeken rechtstreeks van deze iPhone. Gebruik ‘Download naar Apple Watch’ op een boekpagina of in het contextmenu in Mijn boeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Watch pobiera Moje książki bezpośrednio z tego iPhone’a. Użyj opcji „Pobierz na Apple Watch” na stronie książki lub w jej menu kontekstowym w Moich książkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Apple Watch recebe Meus livros diretamente deste iPhone. Use “Baixar no Apple Watch” na página de um livro ou no menu de contexto em Meus livros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Watch получают «Мои книги» напрямую с этого iPhone. Используйте «Загрузить на Apple Watch» на странице книги или в её контекстном меню в «Моих книгах»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Watch 直接从这台 iPhone 获取“我的书”。在书籍页面或“我的书”的上下文菜单中使用“下载到 Apple Watch”。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Watch saa Omat kirjat suoraan tästä iPhonesta. Käytä kirjan sivulla tai Omien kirjojen valikossa kohtaa ”Lataa Apple Watchiin”."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Apple Watch λαμβάνει τα Βιβλία μου απευθείας από αυτό το iPhone. Χρησιμοποιήστε την «Λήψη στο Apple Watch» στη σελίδα ενός βιβλίου ή στο μενού του στα Βιβλία μου."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Watch 直接從這臺 iPhone 獲取“我的書”。在書籍頁面或“我的書”的上下文選單中使用“下載到 Apple Watch”。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Watch gets My Books directly from this iPhone. Use “Download to Apple Watch” on a book page or in its My Books context menu."
          }
        }
      }
