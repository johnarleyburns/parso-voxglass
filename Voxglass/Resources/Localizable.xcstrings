    "Splitting keeps the existing recording on the first half and marks the second half unrecorded. Nothing is deleted." : {
      "comment" : "UI text shown in: Script Editor (Voxglass/Features/Production/Discovery/ScriptEditorView.swift)",
      "localizations" : {
        "de" : {
