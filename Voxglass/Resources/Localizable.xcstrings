    "Your playback position, bookmarks, and favorites sync across devices using your private iCloud account. No app account required." : {
      "comment" : "UI text shown in: Settings (Voxglass/Features/Settings/SettingsView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wiedergabeposition, Lesezeichen und Favoriten werden über Ihren privaten iCloud-Account zwischen Geräten synchronisiert. Kein App-Konto nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your playback position, bookmarks, and favorites sync across devices using your private iCloud account. No app account required."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu posición de reproducción, marcadores y favoritos se sincronizan entre dispositivos con tu cuenta privada de iCloud. No necesitas cuenta en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre position de lecture, vos signets et vos favoris se synchronisent entre vos appareils via votre compte iCloud privé. Aucun compte dans l’app n’est nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מיקום ההשמעה, הסימניות והמועדפים מסונכרנים בין מכשירים דרך חשבון iCloud הפרטי שלך. אין צורך בחשבון באפליקציה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Posizione di riproduzione, segnalibri e preferiti si sincronizzano tra i dispositivi tramite il tuo account iCloud privato. Non serve alcun account nell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "再生位置、ブックマーク、お気に入りは、あなたの個人 iCloud アカウントを使ってデバイス間で同期されます。App のアカウントは不要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je afspeelpositie, bladwijzers en favorieten synchroniseren tussen apparaten via je privé-iCloud-account. Geen app-account nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pozycja odtwarzania, zakładki i ulubione synchronizują się między urządzeniami przez twoje prywatne konto iCloud. Konto w aplikacji nie jest potrzebne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua posição de reprodução, marcadores e favoritos são sincronizados entre dispositivos pela sua conta privada do iCloud. Não é preciso conta no app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Позиция воспроизведения, закладки и избранное синхронизируются между устройствами через ваш личный iCloud. Учётная запись в приложении не нужна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的播放位置、书签和个人收藏会通过你的私人 iCloud 账户在设备间同步。无需 App 账户。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toistokohta, kirjanmerkit ja suosikit synkronoituvat laitteiden välillä yksityisen iCloud-tilisi kautta. Sovellustiliä ei tarvita."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η θέση αναπαραγωγής, οι σελιδοδείκτες και τα αγαπημένα συγχρονίζονται μεταξύ συσκευών μέσω του ιδιωτικού λογαριασμού σας iCloud. Δεν απαιτείται λογαριασμός εφαρμογής."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的播放位置、書籤和個人收藏會通過你的私人 iCloud 賬戶在裝置間同步。無需 App 賬戶。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Your playback position, bookmarks, and favourites sync across devices using your private iCloud account. No app account required."
          }
        }
      }
    },
    "Your preferred sleep-timer length. Pick any duration — or “End of chapter” — from the moon icon while a book is playing." : {
      "comment" : "UI text shown in: Settings (Voxglass/Features/Settings/SettingsView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihre bevorzugte Schlaftimer-Dauer. Wählen Sie während der Wiedergabe über das Mondsymbol eine beliebige Dauer – oder „Kapitelende“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your preferred sleep-timer length. Pick any duration — or “End of chapter” — from the moon icon while a book is playing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu duración preferida del temporizador de apagado. Elige cualquier duración, o «Final del capítulo», desde el icono de la luna mientras escuchas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre durée de minuteur de veille préférée. Choisissez n’importe quelle durée — ou « Fin du chapitre » — avec l’icône de lune pendant la lecture."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אורך טיימר השינה המועדף עליך. במהלך ההשמעה אפשר לבחור כל משך — או „סוף הפרק” — מסמל הירח."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La durata preferita del timer di spegnimento. Scegli qualsiasi durata, o «Fine del capitolo», dall’icona della luna durante la riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "お好みのスリープタイマーの長さです。再生中に月のアイコンから任意の時間や「チャプターの終わり」を選べます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je favoriete duur van de slaaptimer. Kies tijdens het afspelen een willekeurige duur — of ‘Einde van hoofdstuk’ — via het maansymbool."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preferowany czas wyłącznika. Podczas odtwarzania wybierz dowolny czas — lub „Koniec rozdziału” — ikoną księżyca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua duração preferida do timer de sono. Escolha qualquer duração — ou “Fim do capítulo” — no ícone da lua enquanto ouve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Предпочтительная длительность таймера сна. Во время воспроизведения можно выбрать любое время — или «Конец главы» — значком луны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你偏好的睡眠定时时长。播放时可通过月亮图标选择任意时长，或选择“本章结束”。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haluamasi uniajastimen pituus. Valitse mikä tahansa kesto – tai ”Luvun loppu” – kuukuvakkeesta kirjan soidessa."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η διάρκεια χρονοδιακόπτη ύπνου που προτιμάτε. Επιλέξτε οποιαδήποτε διάρκεια — ή «Τέλος κεφαλαίου» — από το εικονίδιο του φεγγαριού ενώ παίζει ένα βιβλίο."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你偏好的睡眠定時時長。播放時可通過月亮圖示選擇任意時長，或選擇“本章結束”。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Your preferred sleep-timer length. Pick any duration — or “End of chapter” — from the moon icon while a book is playing."
          }
        }
      }
    },
