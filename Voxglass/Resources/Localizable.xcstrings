          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有 %lld 部公有領域作品在等待朗讀者。花 20 分鐘錄一個章節，它就會永久加入免費的 LibriVox 目錄，供所有人收聽。"
          }
