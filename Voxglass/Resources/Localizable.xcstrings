    "If a recording doesn't start, check that the microphone is allowed in Settings → Privacy → Microphone." : {
      "comment" : "UI text shown in: Narration Flow (Voxglass/Features/Production/Discovery/NarrationFlow.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn eine Aufnahme nicht startet, prüfen Sie unter „Einstellungen“ > „Datenschutz“ > „Mikrofon“, ob das Mikrofon erlaubt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a recording doesn't start, check that the microphone is allowed in Settings → Privacy → Microphone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si la grabación no empieza, comprueba que el micrófono esté permitido en Ajustes → Privacidad → Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si l’enregistrement ne démarre pas, vérifiez que le micro est autorisé dans Réglages → Confidentialité → Micro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אם ההקלטה לא מתחילה, יש לבדוק שהמיקרופון מורשה בהגדרות ← פרטיות ← מיקרופון."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se la registrazione non si avvia, verifica che il microfono sia consentito in Impostazioni → Privacy → Microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
