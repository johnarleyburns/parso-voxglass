          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Strumieniowanie i wstępne pobieranie następnego rozdziału zawsze używają sieci komórkowej. To ustawienie dotyczy tylko zapisywania całych książek offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O streaming e o pré-carregamento do próximo capítulo sempre usam dados celulares. Isto só controla salvar livros inteiros offline."
          }
        },
        "ru" : {
          "stringUnit" : {
