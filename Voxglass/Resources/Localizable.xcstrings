    "%lld minutes of %@, read by you. Upload it from the LibriVox forum thread to add it to the public domain." : {
      "comment" : "UI text shown in: Narration Flow Screens (Voxglass/Features/Production/Discovery/NarrationFlowScreens.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld Minuten von „%@“, von Ihnen gelesen. Laden Sie die Aufnahme im LibriVox-Forumsthread hoch, um sie gemeinfrei zu veröffentlichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld minutes of %2$@, read by you. Upload it from the LibriVox forum thread to add it to the public domain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld minutos de «%@» leídos por ti. Súbelos al hilo del foro de LibriVox para añadirlos al dominio público."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld minutes de « %@ », lues par vous. Déposez-les dans le fil du forum LibriVox pour les verser au domaine public."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld דקות מתוך „%@”, בקריאתך. אפשר להעלות אותן בשרשור בפורום של LibriVox כדי להוסיף אותן לנחלת הכלל."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld minuti di «%@», letti da te. Caricali nella discussione del forum LibriVox per aggiungerli al pubblico dominio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "あなたが朗読した『%2$@』%1$lld 分。LibriVox フォーラムのスレッドからアップロードすると、パブリックドメインに加わります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
