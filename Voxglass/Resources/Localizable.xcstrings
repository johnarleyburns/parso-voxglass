    "Search, browse, and recommendations are limited to the languages you pick. Leave all off to include every language." : {
      "comment" : "UI text shown in: Settings (Voxglass/Features/Settings/SettingsView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suche, Stöbern und Empfehlungen beschränken sich auf die gewählten Sprachen. Lassen Sie alle aus, um jede Sprache einzubeziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search, browse, and recommendations are limited to the languages you pick. Leave all off to include every language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La búsqueda, la exploración y las recomendaciones se limitan a los idiomas que elijas. Deja todos desactivados para incluirlos todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La recherche, la navigation et les recommandations se limitent aux langues choisies. Laissez tout désactivé pour inclure toutes les langues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "החיפוש, העיון וההמלצות מוגבלים לשפות שבוחרים. אם לא בוחרים אף שפה, כל השפות נכללות."
