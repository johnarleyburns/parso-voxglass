    "A separate budget. Narration never evicts your downloaded audiobooks, and downloads never evict your takes." : {
      "comment" : "UI text shown in: Storage Settings (Voxglass/Features/Production/StorageSettingsView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein eigenes Kontingent. Aufnahmen verdrängen nie Ihre geladenen Hörbücher, und Downloads verdrängen nie Ihre Takes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A separate budget. Narration never evicts your downloaded audiobooks, and downloads never evict your takes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un espacio aparte. Las narraciones nunca desplazan tus audiolibros descargados, y las descargas nunca desplazan tus tomas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un budget séparé. La narration ne supprime jamais vos livres audio téléchargés, et les téléchargements ne suppriment jamais vos prises."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מכסה נפרדת. הקראות לעולם לא דוחקות ספרי שמע שהורדו, והורדות לעולם לא דוחקות את הטייקים שלך."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uno spazio separato. La narrazione non elimina mai gli audiolibri scaricati e i download non eliminano mai le tue riprese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "別枠の容量です。朗読でダウンロード済みのオーディオブックが消えることはなく、ダウンロードでテイクが消えることもありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een apart budget. Opnames verdringen nooit je gedownloade luisterboeken, en downloads nooit je takes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Osobny limit. Nagrania nigdy nie usuwają pobranych audiobooków, a pobieranie nigdy nie usuwa twoich ujęć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um espaço à parte. A narração nunca remove seus audiolivros baixados, e os downloads nunca removem suas tomadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отдельный лимит. Озвучка никогда не вытесняет загруженные аудиокниги, а загрузки — ваши дубли."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "独立的存储配额。朗读绝不会挤掉已下载的有声书，下载也绝不会挤掉你的录音版本。"
          }
        },
        "fi" : {
          "stringUnit" : {
