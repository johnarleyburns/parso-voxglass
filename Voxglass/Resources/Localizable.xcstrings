        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cancelar nunca descarta los capítulos terminados: al reanudar se continuará desde el capítulo %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’annulation ne supprime jamais les chapitres terminés — la reprise commencera au chapitre %lld."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ביטול לעולם לא מוחק פרקים שהושלמו — חידוש בהמשך יתחיל מפרק %lld."
