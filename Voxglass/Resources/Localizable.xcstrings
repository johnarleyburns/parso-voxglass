    "Stay quiet. We measure your room, not your voice." : {
      "comment" : "UI text shown in: Audio Setup (Voxglass/Features/Production/Discovery/AudioSetupView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bitte leise sein. Wir messen Ihren Raum, nicht Ihre Stimme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay quiet. We measure your room, not your voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guarda silencio. Medimos tu sala, no tu voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restez silencieux. Nous mesurons votre pièce, pas votre voix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "נא לשמור על שקט. אנחנו מודדים את החדר, לא את הקול שלך."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Resta in silenzio. Misuriamo l’ambiente, non la tua voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "静かにしてください。測定するのは部屋の音で、声ではありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wees stil. We meten je ruimte, niet je stem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zachowaj ciszę. Mierzymy pomieszczenie, nie twój głos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fique em silêncio. Medimos o ambiente, não a sua voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Соблюдайте тишину. Мы измеряем помещение, а не ваш голос."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请保持安静。我们测量的是房间，而不是你的声音。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ole hiljaa. Mittaamme huonettasi, emme ääntäsi."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Μείνετε σιωπηλοί. Μετράμε τον χώρο σας, όχι τη φωνή σας."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "請保持安靜。我們測量的是房間，而不是你的聲音。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stay quiet. We measure your room, not your voice."
          }
        }
      }
    },
