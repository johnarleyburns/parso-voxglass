    "Cancelling never discards finished chapters — resuming later picks up from chapter %lld." : {
      "comment" : "UI text shown in: Narration Flow Screens (Voxglass/Features/Production/Discovery/NarrationFlowScreens.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Abbrechen gehen fertige Kapitel nie verloren – beim Fortsetzen geht es mit Kapitel %lld weiter."
