    "Automatically boosts quiet recordings so everything stays at a comfortable volume. Especially helpful for older LibriVox audiobooks." : {
      "comment" : "UI text shown in: Settings (Voxglass/Features/Settings/SettingsView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hebt leise Aufnahmen automatisch an, damit alles angenehm laut bleibt. Besonders hilfreich bei älteren LibriVox-Hörbüchern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically boosts quiet recordings so everything stays at a comfortable volume. Especially helpful for older LibriVox audiobooks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sube automáticamente las grabaciones bajas para que todo se oiga a un volumen cómodo. Muy útil con audiolibros antiguos de LibriVox."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Augmente automatiquement le volume des enregistrements faibles pour garder un niveau confortable. Particulièrement utile pour les anciens livres audio LibriVox."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מגביר אוטומטית הקלטות שקטות כדי שהכול יישמע בעוצמה נוחה. מועיל במיוחד לספרי שמע ישנים של LibriVox."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aumenta automaticamente il volume delle registrazioni più basse per un ascolto sempre confortevole. Utile soprattutto con gli audiolibri LibriVox più vecchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "小さな音量の録音を自動で持ち上げ、聞きやすい音量に保ちます。古い LibriVox のオーディオブックで特に効果的です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Versterkt zachte opnames automatisch zodat alles op een prettig volume blijft. Vooral handig bij oudere LibriVox-luisterboeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatycznie wzmacnia ciche nagrania, aby wszystko brzmiało komfortowo. Szczególnie przydatne przy starszych audiobookach LibriVox."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aumenta automaticamente gravações baixas para manter tudo num volume confortável. Ajuda muito em audiolivros antigos do LibriVox."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Автоматически усиливает тихие записи, чтобы громкость оставалась комфортной. Особенно полезно для старых аудиокниг LibriVox."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自动提升音量较小的录音，让所有内容保持舒适音量。对较早的 LibriVox 有声书尤其有用。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vahvistaa hiljaisia äänitteitä automaattisesti, jotta äänenvoimakkuus pysyy miellyttävänä. Hyödyllinen erityisesti vanhemmissa LibriVox-äänikirjoissa."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ενισχύει αυτόματα τις αθόρυβες ηχογραφήσεις ώστε όλα να ακούγονται σε άνετη ένταση. Ιδιαίτερα χρήσιμο για παλαιότερα ηχοβιβλία του LibriVox."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自動提升音量較小的錄音，讓所有內容保持舒適音量。對較早的 LibriVox 有聲書尤其有用。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatically boosts quiet recordings so everything stays at a comfortable volume. Especially helpful for older LibriVox audiobooks."
          }
        }
      }
    },
