    "Renders are chunked by chapter and can be cancelled — finished chapters stay cached and resume from there." : {
      "comment" : "UI text shown in: Narration Flow Screens (Voxglass/Features/Production/Discovery/NarrationFlowScreens.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Renderings erfolgen kapitelweise und lassen sich abbrechen – fertige Kapitel bleiben zwischengespeichert, und es geht dort weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renders are chunked by chapter and can be cancelled — finished chapters stay cached and resume from there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los renderizados se hacen por capítulos y se pueden cancelar: los capítulos terminados se quedan en caché y se reanuda desde ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rendus se font chapitre par chapitre et peuvent être annulés — les chapitres terminés restent en cache et la reprise part de là."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הרינדור מתבצע לפי פרקים ואפשר לבטל אותו — פרקים שהושלמו נשמרים במטמון וממשיכים משם."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I rendering avvengono per capitoli e si possono annullare: i capitoli completati restano in cache e si riprende da lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "レンダリングはチャプターごとに行われ、キャンセルできます。完成したチャプターはキャッシュに残り、そこから再開します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Renders gaan per hoofdstuk en kunnen worden geannuleerd — voltooide hoofdstukken blijven in de cache en je gaat daar verder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Renderowanie odbywa się rozdziałami i można je anulować — gotowe rozdziały zostają w pamięci i od nich zaczyna się wznowienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As renderizações são feitas por capítulo e podem ser canceladas — os capítulos concluídos ficam em cache e a retomada começa dali."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Рендер идёт по главам и его можно отменить — готовые главы остаются в кэше, и работа продолжится с них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "渲染按章节分段进行，可以取消——已完成的章节会保留在缓存中，并从那里继续。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Renderöinnit tehdään luku kerrallaan ja ne voi perua – valmiit luvut pysyvät välimuistissa ja työ jatkuu niistä."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι αποδόσεις χωρίζονται ανά κεφάλαιο και μπορούν να ακυρωθούν — τα ολοκληρωμένα κεφάλαια μένουν στην cache και η εργασία συνεχίζεται από εκεί."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "渲染按章節分段進行，可以取消——已完成的章節會保留在快取中，並從那裡繼續。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Renders are chunked by chapter and can be cancelled — finished chapters stay cached and resume from there."
          }
        }
      }
    },
    "Renders can be cleared any time — they rebuild from your takes. They are the first thing evicted under storage pressure." : {
      "comment" : "UI text shown in: Narration Flow Screens (Voxglass/Features/Production/Discovery/NarrationFlowScreens.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Renderings lassen sich jederzeit löschen – sie werden aus Ihren Takes neu erstellt. Bei Speichermangel werden sie zuerst entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renders can be cleared any time — they rebuild from your takes. They are the first thing evicted under storage pressure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los renderizados se pueden borrar cuando quieras: se reconstruyen a partir de tus tomas. Son lo primero que se elimina si falta espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les rendus peuvent être effacés à tout moment — ils sont reconstruits à partir de vos prises. Ce sont les premiers supprimés quand l’espace manque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אפשר לנקות רינדורים בכל עת — הם נבנים מחדש מהטייקים. הם הראשונים שמפונים כשהאחסון מתמלא."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I rendering si possono cancellare in qualsiasi momento: vengono ricreati dalle tue riprese. Sono i primi a essere rimossi quando lo spazio scarseggia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "レンダリングはいつでも消去できます。テイクから再作成されます。ストレージが不足すると最初に削除されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Renders kun je altijd wissen — ze worden opnieuw gemaakt uit je takes. Bij ruimtegebrek worden ze als eerste verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rendery można w każdej chwili wyczyścić — zostaną odtworzone z twoich ujęć. Przy braku miejsca są usuwane jako pierwsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As renderizações podem ser apagadas a qualquer momento — elas são refeitas a partir das suas tomadas. São as primeiras removidas quando falta espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Рендеры можно удалить в любой момент — они создаются заново из дублей. При нехватке места они удаляются первыми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "渲染文件可随时清除——会根据你的录音版本重新生成。存储紧张时会最先被清除。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Renderöinnit voi tyhjentää milloin tahansa – ne muodostetaan uudelleen otoistasi. Ne poistetaan ensimmäisinä, kun tallennustila käy vähiin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι αποδόσεις μπορούν να διαγραφούν ανά πάσα στιγμή — δημιουργούνται ξανά από τις λήψεις σας. Είναι τα πρώτα που αφαιρούνται όταν ο χώρος αποθήκευσης λιγοστεύει."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "渲染檔案可隨時清除——會根據你的錄音版本重新生成。儲存緊張時會最先被清除。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Renders can be cleared any time — they rebuild from your takes. They are the first thing evicted under storage pressure."
          }
        }
      }
    },
