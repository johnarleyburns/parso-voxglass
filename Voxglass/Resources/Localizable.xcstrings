    "%@ on iPhone · chapters verified in iCloud can be offloaded. Local-only takes are never removed." : {
      "comment" : "UI text shown in: Project Dashboard (Voxglass/Features/Production/Discovery/ProjectDashboardView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ auf dem iPhone · in iCloud bestätigte Kapitel können ausgelagert werden. Nur lokal vorhandene Takes werden nie entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ en el iPhone · los capítulos verificados en iCloud se pueden liberar. Las tomas que solo están en el dispositivo nunca se eliminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
