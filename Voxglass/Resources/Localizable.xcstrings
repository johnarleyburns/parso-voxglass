          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ב-iPhone · אפשר לפנות פרקים שאומתו ב-iCloud. טייקים שקיימים רק במכשיר לעולם לא נמחקים."
          }
        },
        "it" : {
          "stringUnit" : {
