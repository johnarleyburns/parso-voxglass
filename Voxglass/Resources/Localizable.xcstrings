          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ストリーミングと次のチャプターの先読みは常にモバイル通信を使用します。この設定は本全体のオフラインキャッシュだけを制御します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
