    "Warms upcoming chapters so playback never waits. The next chapter is always prefetched for gapless playback." : {
      "comment" : "UI text shown in: Settings (Voxglass/Features/Settings/SettingsView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lädt kommende Kapitel vor, damit die Wiedergabe nie wartet. Das nächste Kapitel wird für nahtlose Wiedergabe immer vorab geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warms upcoming chapters so playback never waits. The next chapter is always prefetched for gapless playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prepara los próximos capítulos para que la reproducción nunca espere. El siguiente capítulo siempre se precarga para reproducir sin pausas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prépare les chapitres suivants pour que la lecture n’attende jamais. Le chapitre suivant est toujours préchargé pour une lecture sans interruption."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מכין מראש את הפרקים הבאים כדי שההשמעה לעולם לא תמתין. הפרק הבא תמיד נטען מראש להשמעה רציפה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prepara i capitoli successivi così la riproduzione non attende mai. Il capitolo successivo viene sempre precaricato per una riproduzione senza pause."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "次のチャプターを事前に準備して、再生が止まらないようにします。ギャップレス再生のため、次のチャプターは常に先読みされます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laadt komende hoofdstukken vooraf zodat afspelen nooit wacht. Het volgende hoofdstuk wordt altijd vooraf opgehaald voor naadloos afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przygotowuje kolejne rozdziały, aby odtwarzanie nigdy nie czekało. Następny rozdział jest zawsze pobierany wstępnie dla płynnego odtwarzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prepara os próximos capítulos para a reprodução nunca esperar. O próximo capítulo é sempre pré-carregado para tocar sem pausas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Заранее готовит следующие главы, чтобы воспроизведение не прерывалось. Следующая глава всегда загружается заранее для непрерывного воспроизведения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
