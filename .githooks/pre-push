#!/bin/bash
# .githooks/pre-push — intentionally a no-op.
# Install with: git config core.hooksPath .githooks
#
# Push runs NO tests and NO guards: a long-running pre-push hook over SSH
# causes GitHub to drop the push connection. CI verifies pushed commits with
# logic tests, the Swift 6 contract guard, and iOS/watchOS builds. Before a
# release, run the local simulator smoke suite explicitly with scripts/test.sh.

set -euo pipefail

exit 0
