#!/bin/bash
# .githooks/pre-push — Fast test gate (swift test only, no UI).
# Install with: git config core.hooksPath .githooks
#
# Runs wiring guards and the logic suites via scripts/test_logic.sh (timing
# suites serialized). Deliberately does NOT run the simulator UI smoke tests:
# they are slow, and a long-running pre-push hook over SSH causes GitHub to
# drop the push connection. The UI smoke tests now run in the pre-commit hook.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo ""
echo "=== pre-push guard (swift test, no UI) ==="

echo ""
echo "--- guard_wiring.sh ---"
if ! bash scripts/guard_wiring.sh; then
  echo ""
  echo "Wiring guards failed. Fix the violations before pushing."
  echo "(You can still push with --no-verify, but CI will block the PR.)"
  exit 1
fi

echo ""
echo "--- logic suites (timing budgets serialized) ---"
bash scripts/test_logic.sh
