#!/bin/bash
# .githooks/pre-push — intentionally a no-op.
# Install with: git config core.hooksPath .githooks
#
# Push runs NO tests and NO guards: a long-running pre-push hook over SSH
# causes GitHub to drop the push connection, and every check (logic tests,
# simulator smoke tests, Swift 6 contract, builds) runs in CI on push. The
# full local gate — swift test + simulator UI smoke tests — lives in the
# pre-commit hook instead.

set -euo pipefail

exit 0
