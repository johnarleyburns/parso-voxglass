#!/bin/bash
# .githooks/commit-msg — stamp the TestFlight build number into every commit
# message so GitHub and App Store Connect correlate 1:1.
#
# The TestFlight job derives the build number from the commit history
# (`.github/workflows/ios.yml`): `build_number="$(git rev-list --count HEAD)"`,
# used as `CURRENT_PROJECT_VERSION` under the single marketing version 1.1.
# This commit's number is its own position in history, i.e. the count once it
# exists — `count(HEAD) + 1` here, because the hook runs before the commit
# object is created.
#
# Result: the pushed tip's message ends with `Build <n>`, and TestFlight shows
# the same `<n>`. Grep the message on GitHub to find the build, and vice versa.

set -euo pipefail

MESSAGE_FILE="$1"

# Idempotent: an amend that keeps the message already carries the number.
if grep -qE '^Build [0-9]+$' "$MESSAGE_FILE"; then
  exit 0
fi

count="$(git rev-list --count HEAD 2>/dev/null || echo 0)"
printf '\n\nBuild %s\n' "$((count + 1))" >> "$MESSAGE_FILE"
