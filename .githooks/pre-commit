#!/bin/bash
# .githooks/pre-commit — Fast unit-test gate.
# Install with: git config core.hooksPath .githooks
#
# Runs swift test (VoxglassCore logic tests, no simulator needed).
# Timing/performance suites run in a separate serial invocation
# (VoxglassPerformanceTests) so their budgets are not skewed by parallel
# suite CPU contention; everything else runs in parallel.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo ""
echo "=== pre-commit guard ==="

echo ""
echo "--- swift test (logic suites, parallel) ---"
swift test --skip VoxglassPerformanceTests

echo ""
echo "--- swift test (timing suites, serial) ---"
swift test --no-parallel --filter VoxglassPerformanceTests
