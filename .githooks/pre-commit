#!/bin/bash
# .githooks/pre-commit — UI smoke-test gate.
# Install with: git config core.hooksPath .githooks
#
# Runs the local UI smoke tests (scripts/test.sh — phone + watch simulators).
# The UI suite moved here from pre-push: it takes minutes, and a long-running
# pre-push hook over SSH made GitHub drop the push connection. Swift test
# (scripts/test_logic.sh) runs on every push instead, so a commit that is never
# pushed costs nothing extra and every pushed commit is still logic-tested.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo ""
echo "=== pre-commit guard (UI smoke tests) ==="
echo ""
bash scripts/test_logic.sh
bash scripts/test.sh
