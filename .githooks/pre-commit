#!/bin/bash
# .githooks/pre-commit — the full verification gate.
# Install with: git config core.hooksPath .githooks
#
# Runs the wiring guards (scripts/guard_wiring.sh), the logic suites
# (scripts/test_logic.sh), and the local UI smoke tests (scripts/test.sh —
# phone + watch simulators) on every commit. Push runs no tests at all (see
# pre-push): CI verifies pushed commits with logic tests, the Swift 6 contract
# guard, and iOS/watchOS builds.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo ""
echo "=== pre-commit guard (wiring guards + logic + UI smoke tests) ==="
echo ""
bash scripts/guard_wiring.sh
bash scripts/test_logic.sh
bash scripts/test.sh
