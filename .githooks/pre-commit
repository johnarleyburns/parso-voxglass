#!/bin/bash
# .githooks/pre-commit — Fast unit-test gate.
# Install with: git config core.hooksPath .githooks
#
# Runs swift test (VoxglassCore logic tests, no simulator needed) via
# scripts/test_logic.sh, which runs the timing/performance suites in a separate
# serial invocation so their budgets are never skewed by parallel-suite CPU
# contention.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo ""
echo "=== pre-commit guard ==="
echo ""
bash scripts/test_logic.sh
