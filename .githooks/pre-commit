#!/bin/bash
# .githooks/pre-commit — the fast host-test gate.
# Install with: git config core.hooksPath .githooks
#
# Runs the Swift package tests only. Simulator UI smoke tests are deliberately
# kept out of the commit path; run scripts/test.sh --all before a release.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo ""
echo "=== pre-commit host tests (swift test --no-parallel) ==="
echo ""
# Keep the commit gate deterministic. Cache/audio suites share process and
# filesystem state, and a parallel host run can race even when each suite is
# individually marked serialized.
swift test --no-parallel
