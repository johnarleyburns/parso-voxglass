#!/bin/bash
# .githooks/pre-commit — the fast host-test gate.
# Install with: git config core.hooksPath .githooks
#
# Runs the Swift package tests only. Simulator UI smoke tests are deliberately
# kept out of the commit path; run scripts/test.sh --all before a release.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo ""
echo "=== pre-commit host tests (swift test) ==="
echo ""
swift test
