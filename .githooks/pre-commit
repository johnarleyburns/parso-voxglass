#!/bin/bash
# .githooks/pre-commit — the fast host-test gate.
# Install with: git config core.hooksPath .githooks
#
# Runs the Swift package tests only. Simulator UI smoke tests are deliberately
# kept out of the commit path; run scripts/test.sh --all before a release.

set -euo pipefail

# git exports GIT_INDEX_FILE to hooks; for a path-limited commit (`git commit -- <paths>`) it is
# an absolute temporary index. SwiftPM's git operations on dependency checkouts inherit it and
# write the dependencies' files into this commit's index, failing the commit with
# "invalid object ... Error building trees". The tests need no git index, so drop it.
unset GIT_INDEX_FILE

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo ""
echo "=== pre-commit host tests (swift test; parallel suites) ==="
echo ""
swift test
