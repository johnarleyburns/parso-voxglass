    "On iPhone, open a book and tap Download to Apple Watch. It keeps your place." : {
      "comment" : "UI text shown in the Voxglass watch redesign (docs/plans/watch-redesign/DESIGN.md).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffne auf dem iPhone ein Buch und tippe auf „Auf Apple Watch laden“. Deine Position bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En el iPhone, abre un libro y toca Descargar en el Apple Watch. Se conserva tu posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sur l’iPhone, ouvrez un livre et touchez Télécharger sur l’Apple Watch. Votre position est conservée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ב‑iPhone, פתחו ספר והקישו על ״הורדה ל‑Apple Watch״. המיקום שלכם יישמר."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sull’iPhone apri un libro e tocca Scarica su Apple Watch. La posizione viene mantenuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhoneでブックを開き、「Apple Watchにダウンロード」をタップしてください。再生位置は保持されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Open op je iPhone een boek en tik op ‘Download naar Apple Watch’. Je plek blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na iPhonie otwórz książkę i stuknij Pobierz na Apple Watch. Twoje miejsce zostanie zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No iPhone, abra um livro e toque em Baixar no Apple Watch. Sua posição é mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На iPhone откройте книгу и нажмите «Загрузить на Apple Watch». Место остановки сохранится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在 iPhone 上打开一本图书，然后轻点“下载到 Apple Watch”。你的进度会保留。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
