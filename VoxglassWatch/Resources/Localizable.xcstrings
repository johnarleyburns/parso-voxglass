    "Voxglass" : {
      "comment" : "Product name; never translated.",
      "shouldTranslate" : false
    },
    "Voxglass plays audiobooks downloaded from your iPhone directly on your wrist — no phone nearby required once a book is on the watch." : {
      "comment" : "UI text shown in: Watch About (VoxglassWatch/WatchAboutView.swift)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass spielt vom iPhone geladene Hörbücher direkt am Handgelenk ab – ist ein Buch einmal auf der Watch, brauchen Sie das iPhone nicht in der Nähe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass reproduce en tu muñeca los audiolibros descargados desde el iPhone: una vez que el libro está en el reloj, no necesitas el iPhone cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass lit directement au poignet les livres audio téléchargés depuis l’iPhone : une fois un livre sur la montre, plus besoin d’avoir l’iPhone à proximité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass מנגן ספרי שמע שהורדו מה-iPhone ישירות על פרק היד — אחרי שהספר נמצא בשעון, אין צורך בטלפון בקרבת מקום."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass riproduce direttamente al polso gli audiolibri scaricati da iPhone: una volta che il libro è su Watch, non serve avere l’iPhone vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass は iPhone からダウンロードしたオーディオブックを手首で直接再生します。本を Watch に入れれば、iPhone が近くになくても聴けます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass speelt luisterboeken die vanaf je iPhone zijn gedownload direct op je pols af — zodra een boek op de Watch staat, hoeft je iPhone niet in de buurt te zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass odtwarza audiobooki pobrane z iPhone’a bezpośrednio na nadgarstku — gdy książka jest już na zegarku, iPhone nie musi być w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Voxglass toca no seu pulso os audiolivros baixados do iPhone — depois que o livro está no relógio, não é preciso ter o iPhone por perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass воспроизводит аудиокниги, загруженные с iPhone, прямо на запястье — когда книга на часах, телефон рядом не нужен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass 可直接在手腕上播放从 iPhone 下载的有声书——书一旦传到手表，就无需 iPhone 在身边。"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass toistaa iPhonesta ladattuja äänikirjoja suoraan ranteessasi – puhelinta ei tarvita lähellä, kun kirja on kellossa."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Voxglass αναπαράγει ηχοβιβλία που κατεβάσατε από το iPhone απευθείας στον καρπό σας — δεν χρειάζεται τηλέφωνο κοντά μόλις το βιβλίο είναι στο ρολόι."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass 可直接在手腕上播放從 iPhone 下載的有聲書——書一旦傳到手錶，就無需 iPhone 在身邊。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voxglass plays audiobooks downloaded from your iPhone directly on your wrist — no phone nearby required once a book is on the watch."
          }
        }
      }
    },
